# Copy this file to .env only when configuring the application.
# OpenAI is the selected Stage 7 provider. Put keys only in ignored .env.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=600

# Local artifact directories, relative to the project root or absolute paths.
CLASSIFIER_DIR=models/ticket_classifier
SENTIMENT_DIR=models/sentiment
